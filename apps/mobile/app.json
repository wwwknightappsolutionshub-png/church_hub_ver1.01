{
  "expo": {
    "name": "Church_Hub",
    "slug": "church-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "churchhub",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#3b4cca"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.churchhub.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3b4cca"
      },
      "package": "com.churchhub.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Church Hub shares your location while driving the church bus.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        { "color": "#3b4cca" }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:4000"
    }
  }
}
