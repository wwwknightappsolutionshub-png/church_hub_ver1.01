/// Service-unit Request to Purchase with SLA tracking.
model RtpRequest {
  id                 String           @id @default(uuid())
  churchId           String
  serviceUnitId      String
  submittedByUserId  String
  title              String
  status             RtpRequestStatus @default(SUBMITTED)
  fieldValues        Json             @default("{}")
  receivedAt         DateTime?
  receivedByUserId   String?
  processingNotifiedAt DateTime?
  approvedAt         DateTime?
  approvedByUserId   String?
  rejectedAt         DateTime?
  rejectionReason    String?
  lastReminderAt     DateTime?
  nextReminderAt     DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  church      Church      @relation(fields: [churchId], references: [id], onDelete: Cascade)
  serviceUnit ServiceUnit @relation(fields: [serviceUnitId], references: [id], onDelete: Cascade)
  submittedBy User        @relation("RtpRequestSubmitter", fields: [submittedByUserId], references: [id], onDelete: Cascade)
  receivedBy  User?       @relation("RtpRequestReceiver", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  approvedBy  User?       @relation("RtpRequestApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([churchId, status, createdAt])
  @@index([serviceUnitId, createdAt])
  @@index([status, nextReminderAt])
  @@map("rtp_requests")
}

model ServiceUnitMeeting {
  id            String    @id @default(uuid())
  serviceUnitId String
  churchId      String
  title         String
  description   String?
  location      String?
  startsAt      DateTime
  endsAt        DateTime?
