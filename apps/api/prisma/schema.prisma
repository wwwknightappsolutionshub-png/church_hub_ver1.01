  recurrence             DevotionalMeetupRecurrence @default(NONE)
  recurrenceSeriesId     String?
  duplicatedFromId       String?
  reminderOffsetsMinutes Json                      @default("[1440,60,10]")
  postEventSummary       String?
  postEventPrayerPoints  String?
  postEventActionSteps   String?
  postEventProgressNote  String?
  postEventCompletedAt   DateTime?
  status                 DevotionalMeetupStatus    @default(SCHEDULED)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  church     Church                     @relation(fields: [churchId], references: [id], onDelete: Cascade)
  group      DevotionalGroup?           @relation(fields: [groupId], references: [id])
  plan       DevotionalPlan?            @relation(fields: [planId], references: [id])
  host       Member?                    @relation("DevotionalMeetupHost", fields: [hostId], references: [id])
  createdBy  Member?                    @relation("DevotionalMeetupCreator", fields: [createdById], references: [id])
  attendees  DevotionalMeetupAttendee[]
  reminders  DevotionalMeetupReminder[]

  @@index([churchId, startsAt])
  @@index([groupId, status, startsAt])
  @@index([recurrenceSeriesId])
  @@map("devotional_meetups")
}

model DevotionalMeetupAttendee {
  id        String                   @id @default(uuid())
  meetupId  String
  memberId  String
  status    DevotionalMeetupRsvpStatus @default(PENDING)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  meetup DevotionalMeetup @relation(fields: [meetupId], references: [id], onDelete: Cascade)
  member Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([meetupId, memberId])
  @@map("devotional_meetup_attendees")
}

model DevotionalMeetupReminder {
  id             String                         @id @default(uuid())
  meetupId       String
  memberId       String
  offsetMinutes  Int
  channel        DevotionalReminderChannel
  fireAt         DateTime
  status         DevotionalReminderDeliveryStatus @default(PENDING)
  title          String
  body           String
  deliveredAt    DateTime?
  notificationId String?
  createdAt      DateTime                       @default(now())

  meetup DevotionalMeetup @relation(fields: [meetupId], references: [id], onDelete: Cascade)
  member Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([meetupId, memberId, offsetMinutes, channel])
  @@index([fireAt, status])
  @@map("devotional_meetup_reminders")
}

model DevotionalDiscussion {
  id        String                   @id @default(uuid())
  churchId  String
  groupId   String?
  planId    String?
  dayId     String?
  memberId  String
  title     String?
  body      String
  status    DevotionalDiscussionStatus @default(OPEN)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  church      Church                        @relation(fields: [churchId], references: [id], onDelete: Cascade)
  group       DevotionalGroup?              @relation(fields: [groupId], references: [id])
  plan        DevotionalPlan?               @relation(fields: [planId], references: [id])
  member      Member                        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  transcripts DevotionalDiscussionTranscript[]

  @@index([groupId, createdAt])
  @@map("devotional_discussions")
}

model DevotionalDiscussionTranscript {
  id             String   @id @default(uuid())
  discussionId   String
  audioUrl       String?
  transcriptText String
  language       String   @default("en")
  durationSec    Int?
  createdAt      DateTime @default(now())

  discussion DevotionalDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@map("devotional_discussion_transcripts")
}

// ─── 2. Chat (ChatChannel, ChatMessage) ──────────────────────

enum YouthChannelRole {
  MEMBER
  MODERATOR
  LEADER
}

enum ChatMessageType {
  TEXT
  IMAGE
  GIF
  SYSTEM
}

model ChatChannel {
  id             String          @id @default(uuid())
  churchId       String
  channelType    ChatChannelType @default(CHURCH)
  youthGroupId   String?
  serviceUnitId  String?
  name           String
  description    String?
  isModerated    Boolean         @default(true)
  isArchived     Boolean         @default(false)
  requiredRole   YouthChannelRole?
  createdAt      DateTime        @default(now())

  church      Church               @relation(fields: [churchId], references: [id], onDelete: Cascade)
  youthGroup  YouthGroup?          @relation(fields: [youthGroupId], references: [id])
  serviceUnit ServiceUnit?         @relation(fields: [serviceUnitId], references: [id])
  messages    Message[]
  members     YouthChannelMember[]

  @@index([churchId, channelType])
  @@map("chat_channels")
}

/// ChatMessage — persisted as `Message` (shared with Communications module).
model Message {
  id            String          @id @default(uuid())
  channelId     String
  senderId      String
  replyToId     String?
  content       String
  messageType   ChatMessageType @default(TEXT)
  attachmentUrl String?
  isPinned      Boolean         @default(false)
  isHidden      Boolean         @default(false)
  isFlagged     Boolean         @default(false)
  flagReason    String?
  moderatedById String?
  moderatedAt   DateTime?
  editedAt      DateTime?
  createdAt     DateTime        @default(now())

  channel     ChatChannel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender      User                     @relation("MessageSender", fields: [senderId], references: [id])
  replyTo     Message?                 @relation("MessageReplies", fields: [replyToId], references: [id])
  replies     Message[]                @relation("MessageReplies")
  readReceipts YouthMessageReadReceipt[]
  reactions   YouthMessageReaction[]

  @@index([channelId, createdAt])
  @@index([channelId, isPinned])
  @@map("messages")
}

model YouthMessageReaction {
  id           String            @id @default(uuid())
  messageId    String
  memberId     String
  reactionType YouthReactionType @default(LIKE)
  createdAt    DateTime          @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([messageId, memberId, reactionType])
  @@map("youth_message_reactions")
}

model YouthChannelMember {
  channelId  String
  memberId   String
  role       YouthChannelRole @default(MEMBER)
  isMuted    Boolean          @default(false)
  mutedUntil DateTime?
  joinedAt   DateTime         @default(now())

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  member  Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([channelId, memberId])
  @@map("youth_channel_members")
}

model YouthMessageReadReceipt {
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation("YouthMessageReadBy", fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@map("youth_message_read_receipts")
}

model Notification {
  id        String   @id @default(uuid())
  churchId  String
  userId    String?
  title     String
  body      String
  type      String
  data      Json     @default("{}")
  readAt    DateTime?
  sentAt    DateTime @default(now())

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([churchId, sentAt])
  @@map("notifications")
}

enum SuggestionTopic {
  CHURCH_SERVICE
  EVANGELISM
  MEMBERSHIP
  GRIEVANCE
  OTHER
}

/// Member-submitted suggestions / feedback for pastors and church admins.
model MemberSuggestion {
  id           String          @id @default(uuid())
  churchId     String
  authorUserId String
  topic        SuggestionTopic
  subject      String?
  body         String
  createdAt    DateTime        @default(now())

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  author User   @relation("MemberSuggestionAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([churchId, createdAt])
  @@index([churchId, topic])
  @@map("member_suggestions")
}

// ─── Service unit email templates ───────────────────────────

enum ServiceUnitEmailTemplateType {
  WELCOME
}

model ServiceUnitEmailTemplate {
  id            String                       @id @default(uuid())
  churchId      String
  serviceUnitId String
  type          ServiceUnitEmailTemplateType @default(WELCOME)
  subject       String
  body          String
  updatedById   String?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  church      Church      @relation(fields: [churchId], references: [id], onDelete: Cascade)
  serviceUnit ServiceUnit @relation(fields: [serviceUnitId], references: [id], onDelete: Cascade)

  @@unique([serviceUnitId, type])
  @@map("service_unit_email_templates")
}

// ─── Prayer Hub & Testimony Hub (community praise posts) ─────

enum CommunityHubType {
  PRAYER
  PRAISE
}

enum CommunityHubStatus {
  PENDING
  APPROVED
  REJECTED
}

model LoungePresence {
  id         String   @id @default(uuid())
  churchId   String
  memberId   String
  lastSeenAt DateTime @default(now())
  isOnline   Boolean  @default(true)

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([churchId, memberId])
  @@index([churchId, isOnline])
  @@map("lounge_presence")
}

model CommunityHubPost {
  id              String             @id @default(uuid())
  churchId        String
  type            CommunityHubType
  authorUserId    String
  authorMemberId  String?
  subject         String?
  testimony       String?
  description     String
  displayName     String?
  showDisplayName Boolean            @default(false)
  status          CommunityHubStatus @default(PENDING)
  approvedById    String?
  approvedAt      DateTime?
  autoApproveAt   DateTime
  rejectedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  member Member? @relation(fields: [authorMemberId], references: [id], onDelete: SetNull)
  likes    CommunityHubLike[]
  comments CommunityHubComment[]

  @@index([churchId, type, status, createdAt])
  @@index([authorUserId, type])
