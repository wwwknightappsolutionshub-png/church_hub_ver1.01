// ─── Follow-Up & Discipleship ────────────────────────────────

enum FollowUpStage {
  NEW_LEAD
  CONTACTED
  VISITED
  ATTENDED
  JOINED_GROUP
}

model FollowUp {
  id           String        @id @default(uuid())
  churchId     String
  memberId     String?
  contactName  String
  contactPhone String?
  contactEmail String?
  stage        FollowUpStage @default(NEW_LEAD)
  assignedToId String?
  dueAt        DateTime?
  completedAt  DateTime?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  church     Church  @relation(fields: [churchId], references: [id], onDelete: Cascade)
  member     Member? @relation(fields: [memberId], references: [id])
  assignedTo User?   @relation("AssignedFollowUps", fields: [assignedToId], references: [id])
  outreachContact OutreachContact?
  reminders  FollowUpReminder[]
  pastoralNotes PastoralNote[]
  counselingCases CounselingCase[]
  carePrayerRequests CarePrayerRequest[]
  automationRuns FollowUpAutomationRun[]

  @@index([churchId, stage])
  @@index([assignedToId, dueAt])
  @@map("follow_ups")
}

model FollowUpReminder {
  id         String   @id @default(uuid())
  followUpId String
  remindAt   DateTime
  sentAt     DateTime?
  channel    String   @default("WHATSAPP")
  message    String?

  followUp FollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)

  @@map("follow_up_reminders")
}

model FollowUpTemplate {
  id        String   @id @default(uuid())
  churchId  String
  name      String
  channel   String
  subject   String?
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([churchId, channel])
  @@map("follow_up_templates")
}

model PastoralNote {
  id             String   @id @default(uuid())
  churchId       String
  memberId       String?
  followUpId     String?
  authorId       String
  content        String
  isConfidential Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  church   Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  member   Member?   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  followUp FollowUp? @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  author   User      @relation("PastoralNoteAuthor", fields: [authorId], references: [id])

  @@index([memberId])
  @@index([followUpId])
  @@map("pastoral_notes")
}

enum FollowUpAutomationTrigger {
  NEW_LEAD
  STAGE_ENTER
  OVERDUE
}

model FollowUpAutomationRule {
  id           String                  @id @default(uuid())
  churchId     String
  name         String
  trigger      FollowUpAutomationTrigger
  stage        FollowUpStage?
  delayHours   Int                     @default(24)
  channel      String                  @default("WHATSAPP")
  message      String?
  templateId   String?
  notifyAssignee Boolean               @default(true)
  isActive     Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  runs   FollowUpAutomationRun[]

  @@index([churchId, trigger, isActive])
  @@map("follow_up_automation_rules")
}

model FollowUpAutomationRun {
  id         String   @id @default(uuid())
  ruleId     String
  followUpId String
  ranAt      DateTime @default(now())

  rule     FollowUpAutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  followUp FollowUp             @relation(fields: [followUpId], references: [id], onDelete: Cascade)

  @@unique([ruleId, followUpId])
  @@map("follow_up_automation_runs")
}

enum CounselingCaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum CounselingCategory {
  COUNSELING
  PRAYER
  CRISIS
  MARRIAGE
  GRIEF
  OTHER
}

model CounselingCase {
  id             String               @id @default(uuid())
  churchId       String
  memberId       String?
  followUpId     String?
  title          String
  category       CounselingCategory   @default(COUNSELING)
  status         CounselingCaseStatus @default(OPEN)
  assignedToId   String?
  isConfidential Boolean              @default(true)
  summary        String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  church       Church              @relation(fields: [churchId], references: [id], onDelete: Cascade)
  member       Member?             @relation(fields: [memberId], references: [id], onDelete: SetNull)
  followUp     FollowUp?           @relation(fields: [followUpId], references: [id], onDelete: SetNull)
  assignedTo   User?               @relation("CounselingAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  sessions     CounselingSession[]

  @@index([churchId, status])
  @@index([assignedToId])
  @@map("counseling_cases")
}

model CounselingSession {
  id          String    @id @default(uuid())
  caseId      String
  authorId    String
  scheduledAt DateTime?
  notes       String
  outcome     String?
  createdAt   DateTime  @default(now())

  case   CounselingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User           @relation("CounselingSessionAuthor", fields: [authorId], references: [id])

  @@index([caseId, scheduledAt])
  @@map("counseling_sessions")
}

enum CarePrayerStatus {
  OPEN
  PRAYING
  ANSWERED
  ARCHIVED
}

model CarePrayerRequest {
  id             String           @id @default(uuid())
  churchId       String
  memberId       String?
  followUpId     String?
  title          String
  details        String
  status         CarePrayerStatus @default(OPEN)
  assignedToId   String?
  isAnonymous    Boolean          @default(false)
  isConfidential Boolean          @default(true)
  answeredAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  church     Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  member     Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  followUp   FollowUp? @relation(fields: [followUpId], references: [id], onDelete: SetNull)
  assignedTo User?     @relation("CarePrayerAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([churchId, status])
  @@map("care_prayer_requests")
}

// ─── Evangelism & Outreach ───────────────────────────────────

model EvangelistQrCode {
  id         String   @id @default(uuid())
  churchId   String
  memberId   String
  code       String   @unique
  nfcUrl     String?
  scanCount  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  church   Church            @relation(fields: [churchId], references: [id], onDelete: Cascade)
  contacts OutreachContact[]

  @@map("evangelist_qr_codes")
}

enum OutreachConvertStage {
  CAPTURED
  CONTACTED
  VISITED
  READY_FOR_MEMBERSHIP
  CONVERTED
  ARCHIVED
}

model OutreachContact {
  id            String   @id @default(uuid())
  churchId      String
  clientId      String?  @unique
  evangelistId  String?
  qrCodeId      String?
  firstName     String
  lastName      String?
  phone         String?
  email         String?
  latitude      Float?
  longitude     Float?
  locationLabel String?
  photoConsent  Boolean  @default(false)
  photoUrl      String?
  notes         String?
  voiceNotes    String?
  convertStage  OutreachConvertStage @default(CAPTURED)
  needsBusPickup Boolean @default(false)
  pickupAddress String?
  busPickupNotes String?
  followUpId    String?  @unique
  memberId      String?
  convertedAt   DateTime?
  welcomeSentAt DateTime?
  syncStatus    SyncStatus @default(SYNCED)
  capturedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  church     Church            @relation(fields: [churchId], references: [id], onDelete: Cascade)
  evangelist Member?           @relation("EvangelistMember", fields: [evangelistId], references: [id])
  qrCode     EvangelistQrCode? @relation(fields: [qrCodeId], references: [id])
  followUp   FollowUp?         @relation(fields: [followUpId], references: [id], onDelete: SetNull)
  member     Member?           @relation("OutreachConvertedMember", fields: [memberId], references: [id], onDelete: SetNull)
  syncConflicts SyncConflict[]

  @@index([churchId, capturedAt])
  @@index([churchId, convertStage])
  @@index([evangelistId])
  @@map("outreach_contacts")
}

enum SyncStatus {
  PENDING
  SYNCING
  SYNCED
  CONFLICT
  FAILED
}

model SyncQueueItem {
  id         String     @id @default(uuid())
  churchId   String
  clientId   String
  entityType String
  payload    Json
  status     SyncStatus @default(PENDING)
  attempts   Int        @default(0)
  lastError  String?
  capturedAt DateTime
  syncedAt   DateTime?
  createdAt  DateTime   @default(now())

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@unique([churchId, clientId, entityType])
  @@index([status, createdAt])
  @@map("sync_queue_items")
}

enum SyncConflictStatus {
  OPEN
  RESOLVED
}

enum SyncConflictResolution {
  CLIENT_WINS
  SERVER_WINS
  MERGED
}

model SyncConflict {
  id                String                  @id @default(uuid())
  churchId          String
  clientId          String
  entityType        String
  outreachContactId String?
  serverPayload     Json
  clientPayload     Json
  mergedPayload     Json?
  status            SyncConflictStatus      @default(OPEN)
  resolution        SyncConflictResolution?
  resolvedByUserId  String?
  resolvedAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  church          Church           @relation(fields: [churchId], references: [id], onDelete: Cascade)
  outreachContact OutreachContact? @relation(fields: [outreachContactId], references: [id], onDelete: SetNull)

  @@unique([churchId, clientId, entityType])
  @@index([churchId, status])
  @@map("sync_conflicts")
}

// ─── Youth Community Module — Phase 2 Prisma Schema ──────────
// Deliverable map (docs/youth/PHASE2-SCHEMA.md):
//   Post→YouthPost | Comment→YouthComment | Reaction→YouthReaction | Media→YouthMedia
//   ChatChannel→ChatChannel | ChatMessage→Message | Event→YouthEvent | RSVP→YouthEventRsvp
//   SermonClip→YouthSermonClip | PrayerRequest→YouthPrayerRequest | PrayerSupport→YouthPrayerSupport
//   Question→YouthQuestion | Answer→YouthAnswer
//   Badge→Badge | Achievement→YouthAchievement | PointLedger→YouthPointLedger
//   Challenge→YouthChallenge | UserLevel→YouthUserLevel (+ MemberGamification)
// ─── Youth Community ─────────────────────────────────────────

model YouthGroup {
  id          String   @id @default(uuid())
  churchId    String
  name        String
  description String?
  leaderId    String?
  minAge      Int?
  maxAge      Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  church   Church             @relation(fields: [churchId], references: [id], onDelete: Cascade)
  members   YouthGroupMember[]
  events    YouthEvent[]
  channels  ChatChannel[]
  resources YouthResource[]
  posts     YouthPost[]

  @@map("youth_groups")
}

model YouthGroupMember {
  id           String   @id @default(uuid())
  youthGroupId String
  memberId     String
  joinedAt     DateTime @default(now())

  youthGroup YouthGroup @relation(fields: [youthGroupId], references: [id], onDelete: Cascade)
  member     Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([youthGroupId, memberId])
  @@map("youth_group_members")
}

model YouthEvent {
  id           String   @id @default(uuid())
  churchId     String
  youthGroupId String?
  busRouteId   String?
  title        String
  description  String?
  location     String?
  coverImageUrl String?
  startsAt     DateTime
  endsAt       DateTime?
  maxAttendees Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  church     Church        @relation(fields: [churchId], references: [id], onDelete: Cascade)
  youthGroup YouthGroup?   @relation(fields: [youthGroupId], references: [id])
  busRoute   BusRoute?     @relation(fields: [busRouteId], references: [id])
  rsvps        YouthEventRsvp[]
  attendance   YouthAttendance[]
  media        YouthEventMedia[]
  feedMedia    YouthMedia[]

  @@index([churchId, startsAt])
  @@map("youth_events")
}

model YouthEventMedia {
  id        String   @id @default(uuid())
  eventId   String
  url       String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  event YouthEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("youth_event_media")
}

