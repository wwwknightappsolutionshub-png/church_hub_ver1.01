}

// ─── Wisdom365+ (licensed daily wisdom journeys) ───────────────

enum Wisdom365VariantSlug {
  BUSINESS_OWNERS
  STUDENTS
  YOUTHS
  KIDS
  HUSBANDS
  WIVES
}

enum Wisdom365ContentStatus {
  DRAFT
  PUBLISHED
}

enum Wisdom365SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Wisdom365Variant {
  id                      String               @id @default(uuid())
  slug                    Wisdom365VariantSlug @unique
  name                    String
  description             String               @db.Text
  imageUrl                String
  bibleTranslationLabel   String
  bibleTranslationCode    String               @default("WEB")
  requiresParentalConsent Boolean              @default(false)
  sortOrder               Int                  @default(0)
  isActive                Boolean              @default(true)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  contentEntries      Wisdom365ContentEntry[]
  licenseAssignments  Wisdom365LicenseAssignment[]
  kidsGrants          Wisdom365KidsGrant[]
  memberProgress      Wisdom365MemberProgress[]
  memberPrefs         Wisdom365MemberPrefs[]

  @@map("wisdom365_variants")
}

model Wisdom365ContentEntry {
  id              String                 @id @default(uuid())
  variantId       String
  dayOfYear       Int
  title           String
  reference       String
  passage         String                 @db.Text
  wisdom          String                 @db.Text
  application     String                 @db.Text
  prayer          String                 @db.Text
  theme           String
  imageUrl        String?
  audioScriptHint String?                @db.Text
  status          Wisdom365ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  variant Wisdom365Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, dayOfYear])
  @@index([variantId, status, dayOfYear])
  @@map("wisdom365_content_entries")
}

model Wisdom365ProductConfig {
  id                          String   @id @default("default")
  licensePricePence           Int      @default(1000)
  multiLicenseDiscountPercent Int      @default(20)
  multiLicenseMinCount        Int      @default(2)
  currency                    String   @default("GBP")
  subscriptionDurationDays    Int      @default(365)
  stripePriceId               String?
  isActive                    Boolean  @default(true)
  updatedAt                   DateTime @updatedAt

  @@map("wisdom365_product_config")
}

model Wisdom365ChurchAvailability {
  id          String   @id @default(uuid())
  churchId    String   @unique
  isAvailable Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@map("wisdom365_church_availability")
}

model Wisdom365Subscription {
  id                      String                      @id @default(uuid())
  userId                  String
  churchId                String
  licenseCount            Int
  status                  Wisdom365SubscriptionStatus @default(PENDING)
  stripeCheckoutSessionId String?                     @unique
  stripeSubscriptionId    String?                     @unique
  stripeCustomerId        String?
  amountPaidPence         Int?
  currency                String                      @default("GBP")
  periodStart             DateTime?
  periodEnd               DateTime?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  user        User                         @relation("Wisdom365Subscriber", fields: [userId], references: [id], onDelete: Cascade)
  church      Church                       @relation(fields: [churchId], references: [id], onDelete: Cascade)
  assignments Wisdom365LicenseAssignment[]

  @@index([userId, status])
  @@index([churchId, status])
  @@map("wisdom365_subscriptions")
}

model Wisdom365LicenseAssignment {
  id               String   @id @default(uuid())
  subscriptionId   String
  variantId        String
  userId           String
  assignedByUserId String
  parentUserId     String?
  childMemberId    String?
  isActive         Boolean  @default(true)
  assignedAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscription Wisdom365Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  variant      Wisdom365Variant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  user         User                  @relation("Wisdom365LicenseUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy   User                  @relation("Wisdom365LicenseAssigner", fields: [assignedByUserId], references: [id], onDelete: Cascade)
  childMember  Member?               @relation("Wisdom365KidsChildMember", fields: [childMemberId], references: [id], onDelete: SetNull)

  @@unique([subscriptionId, variantId])
  @@index([userId, isActive])
  @@map("wisdom365_license_assignments")
}

model Wisdom365KidsGrant {
  id               String   @id @default(uuid())
  parentUserId     String
  childMemberId    String
  variantId        String
  childDisplayName String
  isEnabled        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  parent      User             @relation("Wisdom365KidsParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  childMember Member           @relation("Wisdom365KidsChild", fields: [childMemberId], references: [id], onDelete: Cascade)
  variant     Wisdom365Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, childMemberId, variantId])
  @@map("wisdom365_kids_grants")
}

model Wisdom365MemberProgress {
  id          String    @id @default(uuid())
  userId      String
  variantId   String
  dateKey     String
  completedAt DateTime?
  journalText String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant Wisdom365Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId, dateKey])
  @@index([userId, variantId])
  @@map("wisdom365_member_progress")
}

model Wisdom365MemberPrefs {
  id             String   @id @default(uuid())
  userId         String
  variantId      String
  reminderHour   Int      @default(7)
  reminderMinute Int      @default(0)
  alarmEnabled   Boolean  @default(true)
  timezone       String   @default("UTC")
  streakCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant Wisdom365Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@map("wisdom365_member_prefs")
}

// ─── Ministry / Cells ────────────────────────────────────────

enum CellFormKind {
  WEEKLY_REPORT
  INCIDENT
  CUSTOM
}

enum CellIncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CellIncidentStatus {
  OPEN
  REVIEWING
  RESOLVED
  CLOSED
}

enum CellPrayerStatus {
  OPEN
  PRAYING
  ANSWERED
  CLOSED
}

model CellBranch {
  id           String   @id @default(uuid())
  churchId     String
  name         String
  location     String?
  leaderUserId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  church     Church              @relation(fields: [churchId], references: [id], onDelete: Cascade)
  leader     User?               @relation("CellBranchLeader", fields: [leaderUserId], references: [id], onDelete: SetNull)
  members    CellBranchMember[]
  reports    CellReport[]
  meetings   CellMeeting[]
  attendance CellAttendance[]
  incidents  CellIncident[]
  messages   CellMessage[]
  prayers    CellPrayerRequest[]
  reminders  CellReminder[]

  @@index([churchId, name])
  @@index([churchId, leaderUserId])
  @@map("cell_branches")
}

model CellBranchMember {
  id        String   @id @default(uuid())
  churchId  String
  branchId  String
  memberId  String   @unique
  joinedAt  DateTime @default(now())

  church Church     @relation(fields: [churchId], references: [id], onDelete: Cascade)
  branch CellBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  member Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([churchId, memberId])
  @@index([branchId])
  @@map("cell_branch_members")
}

model CellFormDefinition {
  id          String       @id @default(uuid())
  churchId    String
  kind        CellFormKind
  name        String
  description String?
  fields      Json         @default("[]")
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  church  Church       @relation(fields: [churchId], references: [id], onDelete: Cascade)
  reports CellReport[]

  @@index([churchId, kind, isActive])
  @@map("cell_form_definitions")
}

model CellReport {
  id                String   @id @default(uuid())
  churchId          String
  branchId          String
  formId            String
  submittedByUserId String
  payload           Json     @default("{}")
  submittedAt       DateTime @default(now())

  church      Church             @relation(fields: [churchId], references: [id], onDelete: Cascade)
  branch      CellBranch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  form        CellFormDefinition @relation(fields: [formId], references: [id], onDelete: Cascade)
  submittedBy User               @relation("CellReportSubmitter", fields: [submittedByUserId], references: [id], onDelete: Cascade)

  @@index([churchId, branchId, submittedAt])
  @@map("cell_reports")
}

model CellMeeting {
  id          String   @id @default(uuid())
  churchId    String
  branchId    String
  meetingDate DateTime
  notes       String?
  createdAt   DateTime @default(now())

  church     Church           @relation(fields: [churchId], references: [id], onDelete: Cascade)
  branch     CellBranch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  attendance CellAttendance[]

  @@index([churchId, branchId, meetingDate])
  @@map("cell_meetings")
}

model CellAttendance {
  id                 String   @id @default(uuid())
  churchId           String
  branchId           String
  meetingId          String?
  weekStart          DateTime
  /// Meeting / report date (defaults to weekStart when not provided).
  meetingDate        DateTime?
  presentCount       Int
  absentCount        Int?
  maleCount          Int      @default(0)
  femaleCount        Int      @default(0)
  boysCount          Int      @default(0)
  girlsCount         Int      @default(0)
  testifiersCount    Int      @default(0)
  firstTimersCount   Int      @default(0)
  notes              String?
  recordedByUserId   String
  createdAt          DateTime @default(now())

  church     Church       @relation(fields: [churchId], references: [id], onDelete: Cascade)
  branch     CellBranch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  meeting    CellMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  recordedBy User         @relation("CellAttendanceRecorder", fields: [recordedByUserId], references: [id], onDelete: Cascade)

  @@index([churchId, branchId, weekStart])
  @@map("cell_attendance")
}

model CellIncident {
  id                 String               @id @default(uuid())
  churchId           String
  branchId           String
  title              String
  description        String
  severity           CellIncidentSeverity @default(MEDIUM)
  status             CellIncidentStatus   @default(OPEN)
  reportedByUserId   String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  church     Church     @relation(fields: [churchId], references: [id], onDelete: Cascade)
  branch     CellBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  reportedBy User       @relation("CellIncidentReporter", fields: [reportedByUserId], references: [id], onDelete: Cascade)

  @@index([churchId, branchId, status])
  @@map("cell_incidents")
}

model CellTeachingResource {
  id          String   @id @default(uuid())
  churchId    String
  title       String
  description String?
  fileUrl     String?
  content     String?  @db.Text
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([churchId, sortOrder])
  @@map("cell_teaching_resources")
}

model CellMessage {
  id         String    @id @default(uuid())
  churchId   String
  branchId   String
  fromUserId String
  toUserId   String
  body       String    @db.Text
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  church   Church     @relation(fields: [churchId], references: [id], onDelete: Cascade)
  branch   CellBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  fromUser User       @relation("CellMessageFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User       @relation("CellMessageTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([churchId, branchId, createdAt])
  @@index([toUserId, readAt])
  @@map("cell_messages")
}

model CellPrayerRequest {
  id              String           @id @default(uuid())
  churchId        String
  branchId        String
  memberId        String?
  title           String
  body            String?          @db.Text
  status          CellPrayerStatus @default(OPEN)
  isAnonymous     Boolean          @default(false)
  createdByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  church    Church     @relation(fields: [churchId], references: [id], onDelete: Cascade)
  branch    CellBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  member    Member?    @relation(fields: [memberId], references: [id], onDelete: SetNull)
  createdBy User       @relation("CellPrayerCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([churchId, branchId, status])
  @@map("cell_prayer_requests")
}

model CellReminder {
  id        String    @id @default(uuid())
  churchId  String
  branchId  String?
  userId    String?
  title     String
  body      String?
  remindAt  DateTime
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  church Church      @relation(fields: [churchId], references: [id], onDelete: Cascade)
  branch CellBranch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([churchId, remindAt, sentAt])
  @@map("cell_reminders")
}
