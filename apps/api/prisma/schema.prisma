}

model CommunityHubLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post CommunityHubPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@map("community_hub_likes")
}

model CommunityHubComment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  memberId  String?
  body      String
  createdAt DateTime @default(now())

  post   CommunityHubPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  member Member?          @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
  @@map("community_hub_comments")
}

// ─── Sermon Note (Pastor / Media → weekly devotional) ───────

enum SermonNoteSourceType {
  AUDIO
  TEXT
  PDF
}

enum SermonNoteStatus {
  DRAFT
  PROCESSING
  READY
  PUBLISHED
}

model SermonNote {
  id               String             @id @default(uuid())
  churchId         String
  title            String
  speakerName      String?
  sundayDate       DateTime?
  sourceType       SermonNoteSourceType
  sourceUrl        String?
  sourceText       String?            @db.Text
  pastorContext    String?            @db.Text
  transcript       String?            @db.Text
  summary          String?            @db.Text
  status           SermonNoteStatus   @default(DRAFT)
  devotionalPlanId String?            @unique
  createdById      String
  publishedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  church         Church          @relation(fields: [churchId], references: [id], onDelete: Cascade)
  createdBy      User            @relation("SermonNoteCreator", fields: [createdById], references: [id])
  devotionalPlan DevotionalPlan? @relation("SermonNoteDevotionalPlan", fields: [devotionalPlanId], references: [id])

