  updatedAt     DateTime  @updatedAt

  serviceUnit ServiceUnit @relation(fields: [serviceUnitId], references: [id], onDelete: Cascade)
  church      Church      @relation(fields: [churchId], references: [id], onDelete: Cascade)
  summaries   ServiceUnitMeetingSummary[]

  @@index([serviceUnitId, startsAt])
  @@map("service_unit_meetings")
}

model ServiceUnitPost {
  id            String   @id @default(uuid())
  serviceUnitId String
  authorId      String
  title         String?
  body          String
  isPinned      Boolean  @default(false)
  isLocked      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  serviceUnit ServiceUnit            @relation(fields: [serviceUnitId], references: [id], onDelete: Cascade)
  author      Member                 @relation("ServiceUnitPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  replies     ServiceUnitPostReply[]

  @@index([serviceUnitId, createdAt])
  @@map("service_unit_posts")
}

model ServiceUnitPostReply {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   ServiceUnitPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author Member          @relation("ServiceUnitReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@map("service_unit_post_replies")
}

model ServiceUnitPresence {
  id            String   @id @default(uuid())
  serviceUnitId String
  memberId      String
  lastSeenAt    DateTime @default(now())
  isOnline      Boolean  @default(true)

  serviceUnit ServiceUnit @relation(fields: [serviceUnitId], references: [id], onDelete: Cascade)
  member      Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([serviceUnitId, memberId])
  @@map("service_unit_presence")
