// Church_Hub — Multi-tenant church management database schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Multi-tenant & Auth ─────────────────────────────────────

model Church {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  timezone  String   @default("UTC")
  address   String?
  city      String?
  country   String?
  logoUrl   String?
  settings  Json     @default("{}")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  members            Member[]
  families           Family[]
  followUps          FollowUp[]
  followUpTemplates  FollowUpTemplate[]
  pastoralNotes      PastoralNote[]
  outreachContacts   OutreachContact[]
  evangelistQrCodes  EvangelistQrCode[]
  syncQueueItems     SyncQueueItem[]
  syncConflicts      SyncConflict[]
  youthGroups        YouthGroup[]
  youthEvents        YouthEvent[]
  youthResources     YouthResource[]
  youthHelpRequests  YouthHelpRequest[]
  youthPosts         YouthPost[]
  youthSermonClips   YouthSermonClip[]
  youthMedia         YouthMedia[]
  youthReactions     YouthReaction[]
  youthAchievements  YouthAchievement[]
  youthPointLedgers  YouthPointLedger[]
  youthQuestions     YouthQuestion[]
  youthPrayerRequests YouthPrayerRequest[]
  youthChallenges    YouthChallenge[]
  youthRewards       YouthReward[]
  youthContentReports YouthContentReport[]
  serviceUnits       ServiceUnit[]
  serviceUnitMeetings ServiceUnitMeeting[]
  serviceUnitMeetingSummaries ServiceUnitMeetingSummary[]
  serviceUnitJoinRequests ServiceUnitJoinRequest[]
  businessProfiles   BusinessProfile[]
  marketplaceItems   MarketplaceItem[]
  jobPostings        JobPosting[]
  communitySupportRequests CommunitySupportRequest[]
  konnectEvents      KonnectNetworkingEvent[]
  mentorshipLinks    MentorshipLink[]
  mentorApplications MentorApplication[]
  konnectMentorProfiles KonnectMentorProfile[]
  menteeMentorRequests MenteeMentorRequest[]
  hubIdeas           HubIdea[]
  busRoutes          BusRoute[]
  buses              Bus[]
  rideRequests       RideRequest[]
  announcements      Announcement[]
  sermons            Sermon[]
  sermonNotes        SermonNote[]
  devotionalPlans         DevotionalPlan[]
  devotionalGroups        DevotionalGroup[]
  devotionalGroupInvites  DevotionalGroupInvite[]
  devotionalJournals        DevotionalJournalEntry[]
  devotionalPrayerLists     DevotionalPrayerList[]
  devotionalStudyProgress   DevotionalStudyProgress[]
  devotionalReminders       DevotionalReminder[]
  devotionalReminderPrefs   DevotionalReminderPreference[]
  devotionalReminderDeliveries DevotionalReminderDelivery[]
  devotionalPdfImports    DevotionalPdfImport[]
  devotionalMeetups       DevotionalMeetup[]
  devotionalDiscussions   DevotionalDiscussion[]
  devotionalActionPoints  DevotionalActionPoint[]
  devotionalChallenges    DevotionalChallenge[]
  devotionalPrayerStreaks DevotionalPrayerStreak[]
  devotionalPrayerDailyLogs DevotionalPrayerDailyLog[]
  chatChannels       ChatChannel[]
  notifications      Notification[]
  inAppMessages      InAppMessage[]
  communityHubPosts  CommunityHubPost[]
  serviceUnitEmailTemplates ServiceUnitEmailTemplate[]
  loungePresence     LoungePresence[]
  churchServices           ChurchService[]
  membershipClassDefinitions MembershipClassDefinition[]
  congregantClassifications  CongregantClassification[]
  familyRoleDefinitions      FamilyRoleDefinition[]
  memberCustomFieldDefinitions MemberCustomFieldDefinition[]
  familyCustomFieldDefinitions FamilyCustomFieldDefinition[]
  memberPropertyDefinitions  MemberPropertyDefinition[]
  familyPropertyDefinitions  FamilyPropertyDefinition[]
  memberActivityLogs       MemberActivityLog[]
  classEnrollments         ClassEnrollment[]
  attendanceRecords        AttendanceRecord[]
  followUpAutomationRules  FollowUpAutomationRule[]
  counselingCases          CounselingCase[]
  carePrayerRequests       CarePrayerRequest[]
  communicationQueueItems  CommunicationQueueItem[]
  conversations            Conversation[]
  serviceUnitWeeklyReports ServiceUnitWeeklyReport[]
  serviceUnitAttendance    ServiceUnitAttendance[]
  usheringWeeklyHeadcounts UsheringWeeklyHeadcount[]
  automationSettings       ChurchAutomationSettings?
  automationRunLogs        AutomationRunLog[]
  deptSchedules            DeptSchedule[]
  deptAssignments          DeptAssignment[]
  deptModuleReports        DeptModuleReport[]
  deptInventoryItems       DeptInventoryItem[]
  deptResources            DeptResource[]
  deptTasks                DeptTask[]
  deptIncidents            DeptIncident[]
  deptMedicalTeamAttendance DeptMedicalTeamAttendance[]
  deptChildrenDutyRosters   DeptChildrenDutyRoster[]
  deptChildrenCurriculum    DeptChildrenCurriculum[]
  deptChildrenClassReports  DeptChildrenClassReport[]
  deptChildrenClassEnrollments DeptChildrenClassEnrollment[]
  deptChildrenClassDefinitions DeptChildrenClassDefinition[]
  deptChildCheckIns        DeptChildCheckIn[]
  deptPrayerItems          DeptPrayerItem[]
  deptPrayerAssignments    DeptPrayerAssignment[]
  deptPrayerScheduleSessions DeptPrayerScheduleSession[]
  deptPrayerProgressNotes  DeptPrayerProgressNote[]
  deptPrayerScriptureGuides DeptPrayerScriptureGuide[]
  deptSkills               DeptSkill[]
  deptChoirSongs           DeptChoirSong[]
  deptChoirRosterEntries   DeptChoirRosterEntry[]
  deptChoirSetlists        DeptChoirSetlist[]
  deptChoirSongFeedback    DeptChoirSongFeedback[]
  deptChoirAttendance      DeptChoirAttendance[]
  deptChoirAuditions       DeptChoirAudition[]
  deptChoirVoiceTasks      DeptChoirVoiceTask[]
  deptChoirVocalNotes      DeptChoirVocalNote[]
  deptCertifications       DeptCertification[]
  deptProgressNotes        DeptProgressNote[]
  deptPrayerChecklists     DeptPrayerChecklist[]
  deptFollowUpLogs         DeptFollowUpLog[]
  deptUnitFeedbacks        DeptUnitFeedback[]
  membershipImportJobs     MembershipImportJob[]
  celebrationEmailTemplates CelebrationEmailTemplate[]
  churchCalendarEvents      ChurchCalendarEvent[]
  automationEmailTemplates  AutomationEmailTemplate[]
  wisdom365Subscriptions   Wisdom365Subscription[]
  wisdom365ChurchAvailability Wisdom365ChurchAvailability?
  platformMarketingDrips PlatformMarketingDrip[]
  cellBranches              CellBranch[]
  cellBranchMembers         CellBranchMember[]
  cellFormDefinitions       CellFormDefinition[]
  cellReports               CellReport[]
  cellMeetings              CellMeeting[]
  cellAttendance            CellAttendance[]
  cellIncidents             CellIncident[]
  cellTeachingResources     CellTeachingResource[]
  cellMessages              CellMessage[]
  cellPrayerRequests        CellPrayerRequest[]
  cellReminders             CellReminder[]
  memberSuggestions         MemberSuggestion[]
  rtpFormFields             RtpFormFieldDefinition[]
  rtpRequests               RtpRequest[]

  @@map("churches")
}

/// Fixed worship/service catalog per church (Sunday AM, midweek, etc.)
model ChurchService {
  id          String   @id @default(uuid())
  churchId    String
  name        String
  description String?
  /// 0 = Sunday … 6 = Saturday (optional)
  dayOfWeek   Int?
  /// Local time label e.g. "10:00"
  startTime   String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  church             Church              @relation(fields: [churchId], references: [id], onDelete: Cascade)
  attendanceRecords  AttendanceRecord[]

  @@unique([churchId, name])
  @@index([churchId, isActive, sortOrder])
  @@map("church_services")
}

/// Configurable membership class levels per church (defaults 101–401)
model MembershipClassDefinition {
  id          String   @id @default(uuid())
  churchId    String
  code        String
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  church      Church            @relation(fields: [churchId], references: [id], onDelete: Cascade)
  enrollments ClassEnrollment[]

  @@unique([churchId, code])
  @@index([churchId, isActive, sortOrder])
  @@map("membership_class_definitions")
}

enum MemberActivityType {
  MEMBER_CREATED
  MEMBER_UPDATED
  STATUS_CHANGED
  ONBOARDING_STEP
  ONBOARDING_COMPLETED
  FAMILY_LINKED
  FAMILY_CREATED
  GUARDIAN_LINKED
  GUARDIAN_REMOVED
  CLASS_ENROLLED
  CLASS_COMPLETED
  CLASS_WITHDRAWN
  ATTENDANCE_RECORDED
  MEMBER_DELETED
  MEMBER_IMPORTED
}

model MemberActivityLog {
  id          String             @id @default(uuid())
  churchId    String
  memberId    String
  actorUserId String?
  type        MemberActivityType
  summary     String
  metadata    Json?
  createdAt   DateTime           @default(now())

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  actor  User?  @relation("MemberActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([churchId, memberId, createdAt])
  @@index([memberId, createdAt])
  @@map("member_activity_logs")
}

enum ClassEnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  WITHDRAWN
}

model ClassEnrollment {
  id                String                @id @default(uuid())
  churchId          String
  memberId          String
  classDefinitionId String
  status            ClassEnrollmentStatus @default(ENROLLED)
  enrolledAt        DateTime              @default(now())
  completedAt       DateTime?
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  church            Church                    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  member            Member                    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  classDefinition   MembershipClassDefinition @relation(fields: [classDefinitionId], references: [id], onDelete: Cascade)

  @@unique([memberId, classDefinitionId])
  @@index([churchId, classDefinitionId, status])
  @@map("class_enrollments")
}

enum AttendanceScope {
  SERVICE
  FAMILY
  DEPARTMENT
}

model AttendanceRecord {
  id              String          @id @default(uuid())
  churchId        String
  memberId        String
  churchServiceId String?
  serviceUnitId   String?
  familyId        String?
  serviceDate     DateTime
  scope           AttendanceScope
  present         Boolean         @default(true)
  notes           String?
  recordedById    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  church        Church         @relation(fields: [churchId], references: [id], onDelete: Cascade)
  member        Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  churchService ChurchService? @relation(fields: [churchServiceId], references: [id], onDelete: SetNull)
  serviceUnit   ServiceUnit?   @relation(fields: [serviceUnitId], references: [id], onDelete: SetNull)
  family        Family?        @relation(fields: [familyId], references: [id], onDelete: SetNull)
  recordedBy    User?          @relation("AttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([churchId, serviceDate])
  @@index([memberId, churchServiceId, serviceDate, scope])
  @@index([churchId, churchServiceId, serviceDate])
  @@index([familyId, serviceDate])
  @@index([serviceUnitId, serviceDate])
  @@map("attendance_records")
}

model User {
  id           String    @id @default(uuid())
  /// Null for SaaS platform operators (PLATFORM_ADMIN) who are not tied to one church.
  churchId     String?
  email        String
  passwordHash String
  firstName    String
  lastName     String
  nickname     String?
  phone        String?
  avatarUrl    String?
  isActive             Boolean   @default(true)
  mustChangePassword   Boolean   @default(false)
  lastLoginAt          DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  church       Church?   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  member       Member?
  roles        UserRole[]
  refreshTokens RefreshToken[]
  authLinkTokens AuthLinkToken[]
  assignedFollowUps FollowUp[] @relation("AssignedFollowUps")
  pastoralNotes PastoralNote[] @relation("PastoralNoteAuthor")
  counselingAssigned CounselingCase[] @relation("CounselingAssignee")
  counselingSessionsAuthored CounselingSession[] @relation("CounselingSessionAuthor")
  carePrayerAssigned CarePrayerRequest[] @relation("CarePrayerAssignee")
  assignedHelpRequests YouthHelpRequest[] @relation("HelpAssignee")
  assignedYouthQuestions YouthQuestion[] @relation("YouthQuestionAssignee")
  youthAnswers YouthAnswer[] @relation("YouthAnswerAuthor")
  helpResponses YouthHelpResponse[] @relation("HelpResponder")
  sentMessages Message[] @relation("MessageSender")
  sentInAppMessages InAppMessage[] @relation("InAppSender")
  receivedInAppMessages InAppMessage[] @relation("InAppRecipient")
  notifications Notification[]
  youthMessageReads YouthMessageReadReceipt[] @relation("YouthMessageReadBy")
  driverProfile DriverProfile?
  reviewedServiceUnitJoins ServiceUnitJoinRequest[] @relation("ServiceUnitJoinReviewer")
  communitySupportApprovals CommunitySupportRequest[] @relation("CommunitySupportApprover")
  mentorApplicationApprovals MentorApplication[] @relation("MentorApplicationApprover")
  devotionalPlansCreated   DevotionalPlan[]        @relation("DevotionalPlanCreator")
  devotionalPdfsUploaded   DevotionalPdfImport[]   @relation("DevotionalPdfUploader")
  communityHubLikes        CommunityHubLike[]
  communityHubComments     CommunityHubComment[]
  memberActivitiesAuthored MemberActivityLog[] @relation("MemberActivityActor")
  attendanceRecorded       AttendanceRecord[]  @relation("AttendanceRecordedBy")
  membershipImportsUploaded MembershipImportJob[] @relation("MembershipImportUploader")
  sermonNotesCreated        SermonNote[]          @relation("SermonNoteCreator")
  deptUnitFeedbacksAuthored DeptUnitFeedback[]    @relation("DeptUnitFeedbackUser")
  wisdom365Subscriptions  Wisdom365Subscription[] @relation("Wisdom365Subscriber")
  wisdom365LicenseAssignments Wisdom365LicenseAssignment[] @relation("Wisdom365LicenseUser")
  wisdom365LicenseAssignmentsCreated Wisdom365LicenseAssignment[] @relation("Wisdom365LicenseAssigner")
  wisdom365KidsGrantsParent Wisdom365KidsGrant[] @relation("Wisdom365KidsParent")
  wisdom365MemberProgress   Wisdom365MemberProgress[]
  wisdom365MemberPrefs      Wisdom365MemberPrefs[]
  platformMarketingDrips    PlatformMarketingDrip[]
  cellBranchesLed           CellBranch[]       @relation("CellBranchLeader")
  cellReportsSubmitted      CellReport[]       @relation("CellReportSubmitter")
  cellAttendanceRecorded    CellAttendance[]   @relation("CellAttendanceRecorder")
  serviceUnitAttendanceRecorded ServiceUnitAttendance[] @relation("ServiceUnitAttendanceRecorder")
  cellIncidentsReported     CellIncident[]     @relation("CellIncidentReporter")
  cellMessagesSent          CellMessage[]      @relation("CellMessageFrom")
  cellMessagesReceived      CellMessage[]      @relation("CellMessageTo")
  cellPrayersCreated        CellPrayerRequest[] @relation("CellPrayerCreator")
  memberSuggestionsAuthored MemberSuggestion[] @relation("MemberSuggestionAuthor")
  rtpRequestsSubmitted      RtpRequest[] @relation("RtpRequestSubmitter")
  rtpRequestsReceived       RtpRequest[] @relation("RtpRequestReceiver")
  rtpRequestsApproved       RtpRequest[] @relation("RtpRequestApprover")
  createdCalendarEvents   ChurchCalendarEvent[] @relation("CalendarEventCreator")

  @@unique([churchId, email])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions Permission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id       String @id @default(uuid())
  roleId   String
  resource String
  action   String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@map("permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

enum AuthLinkPurpose {
  PASSWORD_RESET
  MAGIC_LOGIN
}

/// One-time email links for forgot-password and magic sign-in.
model AuthLinkToken {
  id         String          @id @default(uuid())
  userId     String
  purpose    AuthLinkPurpose
  tokenHash  String          @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_link_tokens")
}

/// Tracks failed password attempts per email (login lockout / auto reset).
model LoginFailureBucket {
  id              String   @id @default(uuid())
  emailKey        String   @unique
  attemptCount    Int      @default(0)
  windowStartedAt DateTime @default(now())
  lastAttemptAt   DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("login_failure_buckets")
}

/// SaaS marketing exit-intent / timed-modal trial leads (pre-registration).
model MarketingTrialLead {
  id             String    @id @default(uuid())
  email          String
  emailKey       String
  firstName      String
  lastName       String
  passwordHash   String
  tokenHash      String    @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([emailKey])
  @@map("marketing_trial_leads")
}

// ─── Membership ──────────────────────────────────────────────

enum MemberStatus {
  VISITOR
  NEW_MEMBER
  ACTIVE_MEMBER
  DISCIPLED
}

enum MemberRoleType {
  YOUTH
  ADULT
  LEADER
  DRIVER
  EVANGELIST
  ADMIN
  PASTOR
}

enum MemberGender {
  UNKNOWN
  MALE
  FEMALE
}

enum MembershipCustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  PHONE
  LINK
}

/// Congregant classification taxonomy (CRM: person classifications)
model CongregantClassification {
  id         String   @id @default(uuid())
  churchId   String
  code       String
  name       String
  sortOrder  Int      @default(0)
  isInactive Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  church  Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  members Member[]

  @@unique([churchId, code])
  @@index([churchId, isActive, sortOrder])
  @@map("congregant_classifications")
}

/// Household role within a family (CRM: family roles)
model FamilyRoleDefinition {
  id        String   @id @default(uuid())
  churchId  String
  code      String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  church  Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  members Member[]

  @@unique([churchId, code])
  @@index([churchId, isActive, sortOrder])
  @@map("family_role_definitions")
}

model MemberCustomFieldDefinition {
  id        String                    @id @default(uuid())
  churchId  String
  fieldKey  String
  label     String
  fieldType MembershipCustomFieldType @default(TEXT)
  sortOrder Int                       @default(0)
  isRequired Boolean                  @default(false)
  isActive  Boolean                   @default(true)
  options   Json                      @default("[]")
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  church Church                  @relation(fields: [churchId], references: [id], onDelete: Cascade)
  values MemberCustomFieldValue[]

  @@unique([churchId, fieldKey])
  @@index([churchId, isActive, sortOrder])
  @@map("member_custom_field_definitions")
}

model MemberCustomFieldValue {
  id           String   @id @default(uuid())
  memberId     String
  definitionId String
  valueText    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  member     Member                      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  definition MemberCustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([memberId, definitionId])
  @@map("member_custom_field_values")
}

model FamilyCustomFieldDefinition {
  id        String                    @id @default(uuid())
  churchId  String
  fieldKey  String
  label     String
  fieldType MembershipCustomFieldType @default(TEXT)
  sortOrder Int                       @default(0)
  isRequired Boolean                  @default(false)
  isActive  Boolean                   @default(true)
  options   Json                      @default("[]")
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  church Church                  @relation(fields: [churchId], references: [id], onDelete: Cascade)
  values FamilyCustomFieldValue[]

  @@unique([churchId, fieldKey])
  @@index([churchId, isActive, sortOrder])
  @@map("family_custom_field_definitions")
}

model FamilyCustomFieldValue {
  id           String   @id @default(uuid())
  familyId     String
  definitionId String
  valueText    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  family     Family                      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  definition FamilyCustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([familyId, definitionId])
  @@map("family_custom_field_values")
}

model MemberPropertyDefinition {
  id          String   @id @default(uuid())
  churchId    String
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  church      Church                     @relation(fields: [churchId], references: [id], onDelete: Cascade)
  assignments MemberPropertyAssignment[]

  @@unique([churchId, name])
  @@index([churchId, isActive, sortOrder])
  @@map("member_property_definitions")
}

model MemberPropertyAssignment {
  id           String   @id @default(uuid())
  memberId     String
  definitionId String
  createdAt    DateTime @default(now())

  member     Member                   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  definition MemberPropertyDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([memberId, definitionId])
  @@map("member_property_assignments")
}

model FamilyPropertyDefinition {
  id          String   @id @default(uuid())
  churchId    String
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  church      Church                     @relation(fields: [churchId], references: [id], onDelete: Cascade)
  assignments FamilyPropertyAssignment[]

  @@unique([churchId, name])
  @@index([churchId, isActive, sortOrder])
  @@map("family_property_definitions")
}

model FamilyPropertyAssignment {
  id           String   @id @default(uuid())
  familyId     String
  definitionId String
  createdAt    DateTime @default(now())

  family     Family                   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  definition FamilyPropertyDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([familyId, definitionId])
  @@map("family_property_assignments")
}

model Family {
  id           String   @id @default(uuid())
  churchId     String
  name         String
  headMemberId String?
  address      String?
  address2     String?
  city         String?
  state        String?
  zip          String?
  country      String?
  homePhone    String?
  email        String?
  homeCell     String?
  specialOccasion     String?
  specialOccasionDate DateTime?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  church            Church                     @relation(fields: [churchId], references: [id], onDelete: Cascade)
  members           Member[]
  attendanceRecords AttendanceRecord[]
  customFieldValues FamilyCustomFieldValue[]
  propertyAssignments FamilyPropertyAssignment[]

  @@map("families")
}

enum MembershipImportJobStatus {
  UPLOADED
  PREVIEWED
  COMMITTED
  FAILED
}

enum MembershipImportRowAction {
  CREATE
  UPDATE
  SKIP
  ERROR
}

enum MembershipImportMode {
  MEMBERS
  LEADS
}

model MembershipImportJob {
  id               String                    @id @default(uuid())
  churchId         String
  uploadedByUserId String
  status           MembershipImportJobStatus @default(UPLOADED)
  mode             MembershipImportMode      @default(MEMBERS)
  sourceFilename   String?
  columnMapping    Json                      @default("{}")
  options          Json                      @default("{}")
  rowCounts        Json                      @default("{}")
  summary          Json                      @default("{}")
  errorMessage     String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  committedAt      DateTime?

  church     Church                 @relation(fields: [churchId], references: [id], onDelete: Cascade)
  uploadedBy User                   @relation("MembershipImportUploader", fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  rows       MembershipImportJobRow[]

  @@index([churchId, status, createdAt])
  @@map("membership_import_jobs")
}

model MembershipImportJobRow {
  id        String                     @id @default(uuid())
  jobId     String
  rowIndex  Int
  raw       Json
  mapped    Json                       @default("{}")
  action    MembershipImportRowAction?
  error     String?
  memberId  String?
  familyId  String?
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

