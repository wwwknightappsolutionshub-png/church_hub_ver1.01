enum PlatformEmailTemplateCategory {
  WELCOME
  ONBOARDING
  FEATURES
  REENGAGEMENT
  UPSELL
}

model PlatformEmailTemplate {
  id          String                        @id @default(uuid())
  slug        String                        @unique
  name        String
  category    PlatformEmailTemplateCategory
  subject     String
  htmlBody    String                        @db.Text
  textBody    String?                       @db.Text
  description String?
  isDefault   Boolean                       @default(false)
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  @@index([category])
  @@map("platform_email_templates")
}

model PlatformMarketingDrip {
  id           String    @id @default(uuid())
  churchId     String
  userId       String
  dripStep     Int
  templateSlug String
  scheduledAt  DateTime
  sentAt       DateTime?
  skippedAt    DateTime?
  skipReason   String?
