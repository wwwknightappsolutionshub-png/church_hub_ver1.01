{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "outDir": "./dist/prisma",
    "rootDir": "./prisma",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "downlevelIteration": true
  },
  "include": [
    "prisma/seed.ts",
    "prisma/service-unit-catalog.ts",
    "prisma/seed-test-users.ts",
    "prisma/seed-platform-admin.ts",
    "prisma/test-accounts.ts"
  ]
}
