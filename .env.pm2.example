# PM2 + native services on aaPanel VPS (church-hub.online)
# cp .env.pm2.example .env   then edit secrets and DB password

APP_URL=https://church-hub.online
API_URL=https://church-hub.online
API_PUBLIC_URL=https://church-hub.online
CORS_ORIGINS=https://church-hub.wazconnect.com,https://church-hub.online,https://www.church-hub.online

JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-48
JWT_REFRESH_SECRET=replace-with-openssl-rand-base64-48

# Host Postgres (same instance as your other PM2 apps — separate database)
DATABASE_URL=postgresql://churchhub:REPLACE_PASSWORD@127.0.0.1:5432/churchhub?schema=public

# Host Redis (127.0.0.1:6379)
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# aaPanel Redis usually has requirepass — use either form:
REDIS_PASSWORD=
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@127.0.0.1:6379
CACHE_ENABLED=true

API_PORT=4000
NODE_ENV=production

# Web (build-time + browser)
NEXT_PUBLIC_API_URL=https://church-hub.online
NEXT_PUBLIC_APP_URL=https://church-hub.online
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_PWA_INSTALL_GATE=true
DISABLE_TEST_ACCOUNTS=true

# SSR: web PM2 process → local API
SERVER_API_URL=http://127.0.0.1:4000

# Uploads — local disk or S3-compatible storage
S3_ENDPOINT=
S3_BUCKET=churchhub-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PUBLIC_URL=https://church-hub.online/uploads

# Forgot-password / magic sign-in / OTP (AUTH mailbox)
SMTP_AUTH_HOST=smtp.hostinger.com
SMTP_AUTH_PORT=587
SMTP_AUTH_USER=churchnoreply@church-hub.online
# Quote if the password has | * $ ` spaces
SMTP_AUTH_PASS=
SMTP_AUTH_FROM=churchnoreply@church-hub.online

# Department + cell digests / report mail (REPORTS mailbox)
SMTP_REPORTS_HOST=smtp.hostinger.com
SMTP_REPORTS_PORT=587
SMTP_REPORTS_USER=churchhub@church-hub.online
SMTP_REPORTS_PASS=
SMTP_REPORTS_FROM=churchhub@church-hub.online

# Legacy single-SMTP fallback (used only if SMTP_AUTH_* / SMTP_REPORTS_* are unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@church-hub.online

BUILD_SHA=
GIT_COMMIT=
