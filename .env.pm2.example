# PM2 + native services on aaPanel VPS (church-hub.wazconnect.com)
# cp .env.pm2.example .env   then edit secrets and DB password

APP_URL=https://church-hub.wazconnect.com
API_URL=https://church-hub.wazconnect.com
API_PUBLIC_URL=https://church-hub.wazconnect.com
CORS_ORIGINS=https://church-hub.wazconnect.com

JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-48
JWT_REFRESH_SECRET=replace-with-openssl-rand-base64-48

# Host Postgres (same instance as your other PM2 apps — separate database)
DATABASE_URL=postgresql://churchhub:REPLACE_PASSWORD@127.0.0.1:5432/churchhub?schema=public

# Host Redis (127.0.0.1:6379 — already on your VPS)
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
CACHE_ENABLED=true

API_PORT=4000
NODE_ENV=production

# Web (build-time + browser)
NEXT_PUBLIC_API_URL=https://church-hub.wazconnect.com
NEXT_PUBLIC_APP_URL=https://church-hub.wazconnect.com
NEXT_PUBLIC_DEMO_MODE=false

# SSR: web process → local API (not Docker hostname "api")
SERVER_API_URL=http://127.0.0.1:4000

# Optional: keep MinIO in Docker only, or use real S3/R2
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=churchhub-uploads
S3_ACCESS_KEY=churchhub
S3_SECRET_KEY=churchhub-secret
S3_REGION=us-east-1
S3_PUBLIC_URL=https://church-hub.wazconnect.com/uploads

BUILD_SHA=
GIT_COMMIT=
