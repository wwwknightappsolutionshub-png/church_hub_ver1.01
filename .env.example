# ─── Database ───────────────────────────────────────────────
# Local dev: install PostgreSQL locally, then e.g.:
# postgresql://postgres@localhost:5432/churchhub?schema=public
DATABASE_URL=postgresql://postgres@localhost:5432/churchhub?schema=public

# ─── Redis (optional for local dev) ─────────────────────────
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
# Youth feed/chat cache (memory fallback when Redis unavailable)
CACHE_ENABLED=true

# ─── API (NestJS) ─────────────────────────────────────────────
API_PORT=4000
# Public base URL for uploaded assets (gallery/camera profile photos)
API_PUBLIC_URL=http://localhost:4000
API_URL=http://localhost:4000
NODE_ENV=development

# JWT (generate with: openssl rand -base64 64)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Web (Next.js) ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_DEMO_MODE=true
# Set to false to disable the mobile install + notifications gate
NEXT_PUBLIC_PWA_INSTALL_GATE=true
NEXT_PUBLIC_MAPBOX_TOKEN=

# ─── Object storage (S3-compatible) ───────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=churchhub-uploads
S3_ACCESS_KEY=churchhub
S3_SECRET_KEY=churchhub-secret
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/churchhub-uploads

# ─── Notifications ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Platform WhatsApp gateway (optional env fallback; prefer Platform → Integrations UI)
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_SESSION_ID=
WHATSAPP_API_KEY_HEADER=x-api-key
# Optional dedicated key for encrypting integration secrets (falls back to JWT_ACCESS_SECRET)
INTEGRATION_SECRETS_KEY=
# Dual SMTP (recommended in production)
# AUTH — magic link / reset / OTP
SMTP_AUTH_HOST=
SMTP_AUTH_PORT=587
SMTP_AUTH_USER=
SMTP_AUTH_PASS=
SMTP_AUTH_FROM=churchnoreply@prohost.cloud
# REPORTS — department + cell digests
SMTP_REPORTS_HOST=
SMTP_REPORTS_PORT=587
SMTP_REPORTS_USER=
SMTP_REPORTS_PASS=
SMTP_REPORTS_FROM=churchhub@prohost.cloud
# Legacy single-SMTP fallback if AUTH/REPORTS unset
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@churchhub.local
# Public web URL used inside password-reset and magic-link emails
APP_URL=http://localhost:3001

# ─── Devotional Hub ───────────────────────────────────────────
# Omit DEVOTIONAL_AI_MODEL for stub AI/PDF (local dev). Set to provider id in production.
DEVOTIONAL_AI_MODEL=
DEVOTIONAL_AI_RATE_LIMIT=30
DEVOTIONAL_AI_RATE_WINDOW_MS=60000
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# ─── Maps & routing ───────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
OSRM_BASE_URL=http://router.project-osrm.org

# ─── Mobile (Expo) ──────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:4000
