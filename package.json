{
  "name": "church-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Church_Hub — production-ready church community management platform",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @church-hub/api exec prisma generate",
    "db:migrate": "pnpm --filter @church-hub/api exec prisma migrate dev",
    "db:push": "pnpm --filter @church-hub/api exec prisma db push",
    "db:studio": "pnpm --filter @church-hub/api exec prisma studio",
    "preview": "pnpm --filter @church-hub/web dev",
    "preview:full": "turbo run dev",
    "load:devotional-ai": "node scripts/load/devotional-ai.mjs",
    "load:devotional-pdf": "node scripts/load/devotional-pdf.mjs",
    "test:membership:phase10": "node scripts/membership-phase10/run-phase10.ps1",
    "audit:pwa": "node scripts/membership-phase10/pwa-audit.mjs",
    "audit:security": "node scripts/membership-phase10/security-audit.mjs",
    "test:membership:phase11": "node scripts/membership-phase11/run-phase11.ps1",
    "audit:deploy": "node scripts/membership-phase11/deployment-readiness.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.14.2",
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.3",
      "@types/react-dom": "18.3.0"
    }
  }
}
