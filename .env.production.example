# Production — Church Hub / Devotional Hub
# Copy to your secret manager; do not commit real values.

NODE_ENV=production

# Database (use SSL in production: ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/churchhub?schema=public

# Redis
REDIS_ENABLED=true
REDIS_URL=redis://:PASSWORD@redis-host:6379
CACHE_ENABLED=true

# API
API_PORT=4000
API_URL=https://api.yourchurch.org
CORS_ORIGINS=https://app.yourchurch.org

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Devotional AI (optional — omit for stub mode)
DEVOTIONAL_AI_MODEL=
DEVOTIONAL_AI_RATE_LIMIT=20
DEVOTIONAL_AI_RATE_WINDOW_MS=60000

# Web
NEXT_PUBLIC_API_URL=https://api.yourchurch.org
NEXT_PUBLIC_APP_URL=https://app.yourchurch.org
NEXT_PUBLIC_DEMO_MODE=false

# S3
S3_ENDPOINT=
S3_BUCKET=churchhub-uploads-prod
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PUBLIC_URL=

# Email / SMS (reminders)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourchurch.org
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Disable Swagger in production (set in main.ts or reverse proxy block)
# SWAGGER_ENABLED=false
